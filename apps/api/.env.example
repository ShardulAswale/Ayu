NODE_ENV=development
PORT=3000
# Restrict the Atlas database user to readWrite on the Ayu database only.
MONGODB_URI=mongodb+srv://ayu_app:REPLACE_WITH_SECRET@cluster0.example.mongodb.net/Ayu?retryWrites=true&w=majority
# Comma-separated trusted browser origins; no wildcard for credentialed requests.
CORS_ORIGINS=http://localhost:5173
