    "mongoose": "^8.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "argon2": "^0.41.1",
    "express-session": "^1.18.1",
    "connect-mongo": "^5.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/swagger": "^12.0.2",
